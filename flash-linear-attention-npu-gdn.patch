+"""Host-only checks for the stable GDN provider API."""
+
+import ast
+from pathlib import Path
+
+
+MODULE = Path(__file__).parents[1] / "fla_npu" / "gdn.py"
+
+
+def _source_and_tree():
+    source = MODULE.read_text(encoding="utf-8")
+    return source, ast.parse(source)
+
+
+def _function(tree, name):
+    return next(
+        node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name == name
+    )
+
+
+def _dotted_name(node):
+    parts = []
+    while isinstance(node, ast.Attribute):
+        parts.append(node.attr)
+        node = node.value
+    if isinstance(node, ast.Name):
+        parts.append(node.id)
+    return ".".join(reversed(parts))
+
+
+def test_public_gdn_api_has_no_dynamic_source_loading_or_device_sync():
+    _, tree = _source_and_tree()
+
+    forbidden_attributes = {
+        "torch.npu.synchronize",
+        "sys.path",
+        "sys.modules",
+    }
+    attributes = {_dotted_name(node) for node in ast.walk(tree) if isinstance(node, ast.Attribute)}
+    imported_names = {
+        alias.name
+        for node in ast.walk(tree)
+        if isinstance(node, (ast.Import, ast.ImportFrom))
+        for alias in node.names
+    }
+
+    assert forbidden_attributes.isdisjoint(attributes)
+    assert "spec_from_file_location" not in imported_names
+
+
+def test_triangular_solver_policy_is_explicit_and_fail_closed():
+    _, tree = _source_and_tree()
+    function_source = ast.unparse(_function(tree, "solve_tri"))
+
+    assert "FLA_NPU_GDN_SOLVE_TRI_BACKEND" in function_source
+    assert "solve_tri_ascendc" in function_source
+    assert "solve_tril_npu" in function_source
+    assert "raise ValueError" in function_source
+
+
+def test_public_entries_validate_the_ascendc_runtime():
+    _, tree = _source_and_tree()
+
+    for name in ("causal_conv1d_ascendc", "flash_gated_delta_rule"):
+        function_source = ast.unparse(_function(tree, name))
+        assert "validate_runtime()" in function_source
+
+
+def test_public_api_exports_version_provider_and_training_entries():
+    _, tree = _source_and_tree()
+    assignments = {
+        target.id: node.value
+        for node in tree.body
+        if isinstance(node, ast.Assign)
+        for target in node.targets
+        if isinstance(target, ast.Name)
+    }
+    exported = {
+        item.value
+        for item in assignments["__all__"].elts
+        if isinstance(item, ast.Constant) and isinstance(item.value, str)
+    }
+
+    assert {
+        "GDN_API_VERSION",
+        "GDN_PROVIDER",
+        "causal_conv1d_ascendc",
+        "flash_gated_delta_rule",
+        "validate_runtime",
+    } <= exported
